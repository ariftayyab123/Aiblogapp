# Local dev can use /api with Vite proxy.
# For Vercel production, set this to your deployed backend API base, e.g.:
# VITE_API_URL=https://your-backend-domain.com/api
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000
# URL obfuscation only; backend ownership checks provide authorization.
VITE_BLOG_ID_OBFUSCATION_KEY=change-this-obfuscation-key
